{
  "name": "snug",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "build": "pnpm --filter snug build",
    "test": "pnpm --filter worker test",
    "test:e2e": "node scripts/test-e2e.mjs",
    "seed": "node scripts/seed.mjs",
    "typecheck": "pnpm --filter snug typecheck && pnpm --filter worker exec tsc --noEmit"
  },
  "devDependencies": {
    "@neondatabase/serverless": "^1.1.0"
  }
}

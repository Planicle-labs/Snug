{{ 'snug-widget.css' | asset_url | stylesheet_tag }}
<script src="{{ 'snug-widget.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'snug-size-guide.js' | asset_url }}" defer="defer"></script>

<div
  id="snug-widget-root"
  class="snug-widget-wrapper"
  data-product-id="{{ product.id }}"
  data-product-title="{{ product.title | escape }}"
  data-shop-domain="{{ shop.permanent_domain }}"
  data-api-key="{{ shop.metafields.snug.api_key.value | default: shop.metafields.snug.api_key | escape }}"
  data-worker-url="{{ shop.metafields.snug.worker_url.value | default: shop.metafields.snug.worker_url | default: 'https://snug-worker.planicle-labs.workers.dev' | escape }}"
>
  <button 
    type="button" 
    class="snug-trigger-btn"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="snug-modal-overlay"
    style="display: none;"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="snug-icon" aria-hidden="true" focusable="false">
      <path d="M20.38 3.46L16 2a4 4 0 01-8 0L3.62 3.46a2 2 0 00-1.34 2.23l.58 3.47a1 1 0 00.99.84H6v10a2 2 0 002 2h8a2 2 0 002-2V10h2.15a1 1 0 00.99-.84l.58-3.47a2 2 0 00-1.34-2.23z"/>
    </svg>
    <span class="snug-btn-label">Find Your Size</span>
  </button>
</div>

{% schema %}
{
  "name": "Snug Size Recommender",
  "target": "section",
  "stylesheet": "snug-widget.css",
  "javascript": "snug-widget.js",
  "settings": []
}
{% endschema %}
